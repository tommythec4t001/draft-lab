// Configuração do servidor InHouse na Cloudflare. Publicar: "Publicar servidor InHouse.bat" (ou npx wrangler deploy).
{
  "name": "draft-lab-inhouse",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SALAS", "class_name": "Sala" },
      { "name": "ARQUIVO", "class_name": "Arquivo" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sala", "Arquivo"] }
  ],
  "vars": {
    // Nome da partida personalizada: {n} vira o número, que sobe 1 a cada sala criada.
    "NOME_PARTIDA": "DraftLab {n}",
    "PARTIDA_INICIAL": "1"
  },
  "observability": { "enabled": true }
}
